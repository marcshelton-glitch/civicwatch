ianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"supabase/migrations/20260615000001 + create_rate_limits"},{"id":13,"name":"Set up Better Stack uptime monitor","phase":"Phase 1 Hardening","planned":{"start":"2026-07-12","end":"2026-07-13"},"scheduled":{"start":"2026-07-12","end":"2026-07-13"},"status":"done","actualCompletionDate":"2026-08-26","varianceDays":44,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"Better Stack monitor confirmed live on civicwatch.app (up 3mo+); /api/health monitor added as a follow-on hardening step"},{"id":14,"name":"Verify Clerk webhook secret, test user.created","phase":"Phase 1 Hardening","planned":{"start":"2026-09-03","end":"2026-09-04"},"scheduled":{"start":"2026-09-03","end":"2026-09-04"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"durationWorkdays":1},{"id":15,"name":"Push fix/prelaunch-revenue-and-security to origin","phase":"P0 Launch Blockers","planned":{"start":"2026-08-11","end":"2026-08-11"},"scheduled":{"start":"2026-08-11","end":"2026-08-13"},"status":"done","actualCompletionDate":"2026-08-13","varianceDays":2,"needsAttention":false,"attentionReason":null,"dependsOn":[]},{"id":16,"name":"Confirm Vercel preview build succeeds","phase":"P0 Launch Blockers","planned":{"start":"2026-08-11","end":"2026-08-12"},"scheduled":{"start":"2026-08-11","end":"2026-08-13"},"status":"done","actualCompletionDate":"2026-08-13","varianceDays":1,"needsAttention":false,"attentionReason":null,"dependsOn":["Push fix/prelaunch-revenue-and-security to origin"]},{"id":17,"name":"Apply migrations/009 RLS fix in Supabase","phase":"P0 Launch Blockers","planned":{"start":"2026-08-11","end":"2026-08-12"},"scheduled":{"start":"2026-08-11","end":"2026-08-13"},"status":"done","actualCompletionDate":"2026-08-13","varianceDays":1,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"live data exposure — table is empty today, close it before driving traffic"},{"id":18,"name":"Merge to main","phase":"P0 Launch Blockers","planned":{"start":"2026-08-12","end":"2026-08-13"},"scheduled":{"start":"2026-08-12","end":"2026-08-13"},"status":"done","actualCompletionDate":"2026-08-13","varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":["Confirm Vercel preview build succeeds","Apply migrations/009 RLS fix in Supabase"]},{"id":19,"name":"Verify /api/health returns status ok","phase":"P0 Launch Blockers","planned":{"start":"2026-08-13","end":"2026-08-13"},"scheduled":{"start":"2026-08-13","end":"2026-08-13"},"status":"done","actualCompletionDate":"2026-08-26","varianceDays":13,"needsAttention":false,"attentionReason":null,"dependsOn":["Merge to main"],"note":"https://www.civicwatch.app/api/health confirmed {status:'ok', db:'ok', billing fully configured}"},{"id":22,"name":"Source committee rosters from congress-legislators","phase":"P0 Product Claim","planned":{"start":"2026-08-04","end":"2026-08-05"},"scheduled":{"start":"2026-08-04","end":"2026-08-05"},"status":"done","actualCompletionDate":"2026-08-04","varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"commit 2cc1f0e"},{"id":23,"name":"Backfill bioguide_id on fd_trades (5,076 rows)","phase":"P0 Product Claim","planned":{"start":"2026-09-07","end":"2026-09-10"},"scheduled":{"start":"2026-09-07","end":"2026-09-10"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":["Run one real-card checkout end to end"],"note":"unlocks Trade Conflict Analysis — the thing marketing sells","durationWorkdays":3},{"id":24,"name":"Purge/repair 27 future-dated trades","phase":"P0 Product Claim","planned":{"start":"2026-09-11","end":"2026-09-14"},"scheduled":{"start":"2026-09-11","end":"2026-09-14"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"durationWorkdays":1},{"id":25,"name":"Fix the ingest date parser","phase":"P0 Product Claim","planned":{"start":"2026-09-15","end":"2026-09-16"},"scheduled":{"start":"2026-09-15","end":"2026-09-16"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":["Purge/repair 27 future-dated trades"],"durationWorkdays":1},{"id":26,"name":"Automate ingest off local Mac","phase":"P0 Product Claim","planned":{"start":"2026-08-22","end":"2026-08-25"},"scheduled":{"start":"2026-08-22","end":"2026-08-25"},"status":"done","actualCompletionDate":"2026-08-30","varianceDays":5,"needsAttention":false,"attentionReason":null,"dependsOn":["Fix the ingest date parser"],"note":"Shipped ahead of its listed dependency (task 25, still pending) — the scheduling work turned out to be independent of the date-parser bug. Two GitHub Actions workflows (.github/workflows/ingest-house.yml every 6h, ingest-senate.yml daily) replace ingest-loop.sh/ingest-senate-loop.sh; both call the existing scripts/ingest-*.mjs unchanged, writing to Supabase directly. Verified live, not just committed: House workflow has 20 recorded runs (scheduled runs completing in 15–22s, draining the unprocessed-rows backlog as designed), Senate has 9 (task 27's note has senate_trades=7,164 / senate_net_worth=83 rows from this same pipeline). See docs/automate-ingest-2026-08-26.md. Also closed a follow-up from that doc while verifying: package-lock.json now resolves playwright cleanly (npm ci --dry-run), so ingest-senate.yml's dependency-install step was switched back from npm install to npm ci; package.json's ingest:index/trades/networth scripts were pointed at the real scripts/ingest-disclosures.mjs filename (they'd been referencing a .js path that doesn't exist — unused by the workflows, which call the script directly, but broken for anyone running npm run ingest:* by hand). Not done: task 24 (future-dated trades) and task 25 (date parser) remain open, unrelated data-quality issues — automation moving the ingest off the Mac doesn't require fixing what the ingest parses."},{"id":27,"name":"Senate ingest — senate_trades and senate_net_worth are empty","phase":"P0 Product Claim","planned":{"start":"2026-08-25","end":"2026-08-29"},"scheduled":{"start":"2026-08-25","end":"2026-08-29"},"status":"done","actualCompletionDate":"2026-08-30","varianceDays":1,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"Root cause was two-layered: (1) raw fetch() was WAF-blocked by efdsearch.senate.gov almost 100% of the time — fixed with a real Playwright browser session (scripts/lib/senate-efd-browser.mjs); (2) the site had also been redesigned (5-column search rows, no more data.json API, PDFs replaced by HTML tables) — fixed with scrapeReportTables()/computeNetWorth(). Verified via direct Supabase query, not just a green Action run: senate_trades=7,164 rows, senate_net_worth=83 rows. See docs/senate-waf-2026-08-29.md. A full backlog catch-up run (limits raised to 2000) was in progress as of this checkmark."},{"id":36,"name":"Fix sharp on Vercel — rep photos 500 on every request","phase":"P0 Product Claim","planned":{"start":"2026-09-17","end":"2026-09-18"},"scheduled":{"start":"2026-09-17","end":"2026-09-18"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"durationWorkdays":1,"note":"EVIDENCE: /api/rep-photo/[bioguideId] throws on every request — ~1,858 errors across 22 groups in 4 days (Vercel runtime errors, 2026-08-27 to 08-31, lastDeployment dpl_ATAR7yyowjAd828XQXigWVhzXT6z). Every representative photo on the site is broken, including on /pro where Pro is sold.\n\nERROR: 'Failed to load external module sharp-...: Could not load the \"sharp\" module using the linux-x64 runtime / ERR_DLOPEN_FAILED: libvips-cpp.so.8.18.3: cannot open shared object file'.\n\nNOT THE CAUSE: the platform binaries are already in package-lock.json (@img/sharp-linux-x64 and @img/sharp-libvips-linux-x64 both present, 26 sharp packages total). 'npm install --os=linux --cpu=x64 sharp' is a no-op here — checked 2026-08-31.\n\nLIKELY CAUSE: next.config.mjs sets `const nextConfig = {}` with no serverExternalPackages. The stack frame is the turbopack runtime and the message says 'external module', so Next 16.2.2 is externalising sharp without tracing the native .so into the function bundle. Route already correctly declares runtime = 'nodejs'.\n\nFIRST THING TO TRY (verify against Next 16 docs before committing): add serverExternalPackages: ['sharp'] to nextConfig in next.config.mjs, deploy to a preview, and hit /api/rep-photo/S000344. If that misses, try outputFileTracingIncludes for the route.\n\nALSO SPOTTED: next.config.js.disabled-duplicate is sitting next to next.config.mjs. Confirm which config Next actually loads before debugging."},{"id":28,"name":"Set RESEND_API_KEY","phase":"Measurement","planned":{"start":"2026-08-16","end":"2026-08-16"},"scheduled":{"start":"2026-08-16","end":"2026-08-16"},"status":"done","actualCompletionDate":"2026-08-30","varianceDays":14,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"stops churning failed cards"},{"id":29,"name":"Set NEXT_PUBLIC_GA_MEASUREMENT_ID","phase":"Measurement","planned":{"start":"2026-08-16","end":"2026-08-16"},"scheduled":{"start":"2026-08-16","end":"2026-08-16"},"status":"done","actualCompletionDate":"2026-08-30","varianceDays":14,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"G-4KLY81XR45 set in .env.local and Vercel (Production + Preview); redeploy triggered"},{"id":30,"name":"Fire Purchase events on both pixels","phase":"Measurement","planned":{"start":"2026-08-17","end":"2026-08-18"},"scheduled":{"start":"2026-08-17","end":"2026-08-18"},"status":"done","actualCompletionDate":"2026-08-30","varianceDays":12,"needsAttention":false,"attentionReason":null,"dependsOn":["Set NEXT_PUBLIC_GA_MEASUREMENT_ID"],"note":"Verified live 2026-08-30 — see docs/conversion-tracking-audit-2026-08-29.md. Both pixels were CSP-blocked (fbevents.js/events.js never loaded), the Purchase/CompletePayment code was written but never deployed, and /api/funnel-event 401'd signed-out callers via a middleware gap. All three fixed and confirmed live: real network calls to facebook.com/tr (ev=Purchase) and analytics.tiktok.com/api/v2/pixel. NOTE: this task's own dependsOn (task 29, NEXT_PUBLIC_GA_MEASUREMENT_ID) is still pending — GA itself remains unset, unrelated to whether the pixels fire."},{"id":31,"name":"Set OPENSTATES_API_KEY and ship State & Local Lookup","phase":"Measurement","planned":{"start":"2026-08-18","end":"2026-08-20"},"scheduled":{"start":"2026-08-18","end":"2026-08-20"},"status":"done","actualCompletionDate":"2026-08-30","varianceDays":10,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"Marc registered a free key at open.pluralpolicy.com (marc61); key set in .env.local and in Vercel (Production). Vercel auto-redeployed (dpl_FAGZCJ7oNUHd2sJFujghqsiaQNUS, READY, aliased to civicwatch.app). Verified live by calling v3.openstates.org/people.geo directly with the key — returns real results (e.g. DC councilmembers for a DC address). /api/civic itself is Clerk-gated so it 401s for signed-out callers by design; that's confirmed working too (GET /api/civic 401 in runtime logs), not a bug. REMAINING: the Vercel env var is only scoped to Production right now — add the Preview checkbox too so PR/preview deploys get state legislator data as well."},{"id":32,"name":"Rewrite /pro around what actually works","phase":"Brand & Content","planned":{"start":"2026-09-21","end":"2026-09-23"},"scheduled":{"start":"2026-09-21","end":"2026-09-23"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":["Backfill bioguide_id on fd_trades (5,076 rows)"],"note":"currently undersells what works, oversells what doesn't","durationWorkdays":2},{"id":33,"name":"Generate .env.example","phase":"Standard Adoption","planned":{"start":"2026-08-11","end":"2026-08-11"},"scheduled":{"start":"2026-08-11","end":"2026-08-11"},"status":"done","actualCompletionDate":"2026-08-11","varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[]},{"id":6,"name":"Test push end-to-end on Chrome + Safari","phase":"Phase 1 Hardening","planned":{"start":"2026-09-24","end":"2026-09-25"},"scheduled":{"start":"2026-09-24","end":"2026-09-25"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":["Implement /api/push/send via web-push"],"durationWorkdays":1},{"id":11,"name":"Run K6 load test at 50 VUs","phase":"Phase 1 Hardening","planned":{"start":"2026-09-28","end":"2026-09-29"},"scheduled":{"start":"2026-09-28","end":"2026-09-29"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"durationWorkdays":1},{"id":34,"name":"Resolve D-001 — which migration directory is authoritative","phase":"Standard Adoption","planned":{"start":"2026-09-30","end":"2026-10-02"},"scheduled":{"start":"2026-09-30","end":"2026-10-02"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"durationWorkdays":2},{"id":35,"name":"Resolve D-002 — move loose docs into the standard structure","phase":"Standard Adoption","planned":{"start":"2026-10-05","end":"2026-10-12"},"scheduled":{"start":"2026-10-05","end":"2026-10-12"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"durationWorkdays":5}],"wave":1,"waveLabel":"Live — nearest revenue","active":true,"baselineHistory":[{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-08-20","projected":"2026-08-29","varianceDays":9},"tasksRebaselined":11},{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-10-12","projected":"2026-10-12","varianceDays":0},"tasksRebaselined":12},{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-10-14","projected":"2026-10-14","varianceDays":0},"tasksRebaselined":11},{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-10-14","projected":"2026-10-14","varianceDays":0},"tasksRebaselined":11},{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-10-12","projected":"2026-10-12","varianceDays":0},"tasksRebaselined":11},{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-10-12","projected":"2026-10-12","varianceDays":0},"tasksRebaselined":11},{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-10-12","projected":"2026-10-12","varianceDays":0},"tasksRebaselined":11},{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-10-12","projected":"2026-10-12","varianceDays":0},"tasksRebaselined":11},{"resetOn":"2026-08-31","newBaselineStart":"2026-09-01","wave":1,"priorLaunch":{"planned":"2026-10-12","projected":"2026-10-12","varianceDays":0},"tasksRebaselined":11}]}</script>

<script>
'use strict';
// ─── DATA ────────────────────────────────────────────────────────────────────
const SNAPSHOT = JSON.parse(document.getElementById('embedded-gantt-state').textContent);
// gantt-state.json's "phases" is a plain string[] (see adoptExternal below, which
// already expects that shape from a freshly-fetched file). Normalize the embedded
// copy the same way up front, so rendering doesn't depend on fetch() succeeding —
// which it won't under file:// (Safari/Chrome block local-file fetch), leaving this
// as the only code path that actually runs for anyone opening the file directly.
if (Array.isArray(SNAPSHOT.phases) && typeof SNAPSHOT.phases[0] === 'string') {
  SNAPSHOT.phases = SNAPSHOT.phases.map(name => ({ name, emoji: '\u{1F539}', color: '#64748b' }));
}
const PHASES = {};
SNAPSHOT.phases.forEach(p => { PHASES[p.name] = p; });
const TASKS = SNAPSHOT.tasks;

const DAY_W  = 18;
const LS_KEY = 'cw-gantt-progress-v1';

function parseDate(s){ const [y,m,d]=s.split('-').map(Number); return new Date(y,m-1,d); }
function fmtDate(s){ if(!s) return '—'; return parseDate(s).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}); }

const now_ = new Date();
const TODAY   = new Date(now_.getFullYear(), now_.getMonth(), now_.getDate());
const TODAY_S = [TODAY.getFullYear(), String(TODAY.getMonth()+1).padStart(2,'0'), String(TODAY.getDate()).padStart(2,'0')].join('-');

// ─── LOCAL PROGRESS OVERLAY ─────────────────────────────────────────────────
// The embedded snapshot is this session's source of truth. Local toggles let
// you click through it live; "Export for Claude" writes the overlay back out
// as a complete gantt-state.json so Claude can pick up real changes.
let overlay = {};
function loadOverlay(){
  try{ overlay = JSON.parse(localStorage.getItem(LS_KEY) || '{}'); }catch(e){ overlay = {}; }
  TASKS.forEach(t=>{
    const o = overlay[t.id];
    if(!o) return;
    t.status = o.status;
    t.actualCompletionDate = o.actualCompletionDate || null;
  });
}
function saveOverlay(){
  const o = {};
  TASKS.forEach(t=>{ if(t.status==='done') o[t.id] = {status:'done', actualCompletionDate:t.actualCompletionDate}; });
  overlay = o;
  try{ localStorage.setItem(LS_KEY, JSON.stringify(o)); }catch(e){}
}

// ─── RECOMPUTE (status / attention / totals) ────────────────────────────────
function recompute(){
  let att = 0, done = 0;
  TASKS.forEach(t=>{
    t.varianceDays = (t.scheduled.end && t.planned.end)
      ? Math.round((parseDate(t.scheduled.end)-parseDate(t.planned.end))/864e5) : 0;
    if(t.status === 'done'){
      done++; t.needsAttention = false; t.attentionReason = null;
    } else if(t.scheduled.end && t.scheduled.end < TODAY_S){
      t.needsAttention = true; t.attentionReason = 'past scheduled end date, not marked done'; att++;
    } else if((t.dependsOn||[]).some(n=>{
        const d = TASKS.find(x=>x.name===n);
        return d && d.status !== 'done' && d.scheduled && d.scheduled.end < TODAY_S;
      })){
      t.needsAttention = true; t.attentionReason = 'blocked by an overdue dependency'; att++;
    } else {
      t.needsAttention = false; t.attentionReason = null;
    }
  });
  const total = TASKS.length;
  SNAPSHOT.totals = { total, done, remaining: total-done, pctDone: total ? Math.round(done/total*100) : 0 };
  SNAPSHOT.needsAttentionCount = att;
  const ends = TASKS.map(t=>t.scheduled && t.scheduled.end).filter(Boolean).sort();
  SNAPSHOT.launch = SNAPSHOT.launch || {planned:null, projected:null, varianceDays:0};
  SNAPSHOT.launch.projected = ends.length ? ends[ends.length-1] : SNAPSHOT.launch.planned;
  SNAPSHOT.launch.varianceDays = (SNAPSHOT.launch.planned && SNAPSHOT.launch.projected)
    ? Math.round((parseDate(SNAPSHOT.launch.projected)-parseDate(SNAPSHOT.launch.planned))/864e5) : 0;
}

// ─── DONE ACTIONS ────────────────────────────────────────────────────────────
function quickToggleDone(id){
  const t = TASKS.find(x=>x.id===id);
  if(t.status==='done'){ t.status='pending'; t.actualCompletionDate=null; }
  else{
    const d = window.prompt(`Actual completion date for:\n"${t.name}"\n\nScheduled end was ${fmtDate(t.scheduled.end)}. Enter YYYY-MM-DD:`, TODAY_S);
    if(d===null) return;
    if(!/^\d{4}-\d{2}-\d{2}$/.test(d.trim())){ alert('Please use YYYY-MM-DD.'); return; }
    t.status='done'; t.actualCompletionDate=d.trim();
  }
  saveOverlay(); renderAll();
}
function markPending(id){
  const t = TASKS.find(x=>x.id===id);
  t.status='pending'; t.actualCompletionDate=null;
  saveOverlay(); renderAll();
}
function resetAll(){
  if(!confirm('Reset all local progress edits back to the embedded snapshot?')) return;
  try{ localStorage.removeItem(LS_KEY); }catch(e){}
  location.reload();
}

// ─── EXPORT ──────────────────────────────────────────────────────────────────
function buildSnapshot(){
  recompute();
  return {
    project: 'civicwatch', standardVersion: '1.0.0',
    exportedAt: new Date().toISOString(), today: TODAY_S,
    totals: SNAPSHOT.totals, launch: SNAPSHOT.launch, needsAttentionCount: SNAPSHOT.needsAttentionCount,
    phases: SNAPSHOT.phases.map(p=>p.name),
    tasks: TASKS.map(t=>({
      id:t.id, name:t.name, phase:t.phase, planned:t.planned, scheduled:t.scheduled,
      status:t.status, actualCompletionDate:t.actualCompletionDate, varianceDays:t.varianceDays,
      needsAttention:t.needsAttention, attentionReason:t.attentionReason, dependsOn:t.dependsOn,
      note:t.note || undefined,
    })),
  };
}
function exportProgressSnapshot(){
  const blob = new Blob([JSON.stringify(buildSnapshot(), null, 2)+'\n'], {type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = 'gantt-state.json'; a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href), 1000);
  toast('Exported — replace 70-schedule/gantt-state.json with this file.');
}

function icsDate(s){ return s.replace(/-/g,''); }
function uid(){ return 'cw-'+Date.now()+'-'+Math.random().toString(36).slice(2,8); }
function generateICS(tasks){
  const now = new Date().toISOString().replace(/[-:]/g,'').split('.')[0]+'Z';
  const cals = tasks.map(t=>{
    const ph = PHASES[t.phase] || {emoji:'',name:t.phase};
    const desc = [`Phase: ${ph.emoji} ${t.phase}`, t.note?`Note: ${t.note}`:'',
      `Scheduled: ${fmtDate(t.scheduled.start)} \u2192 ${fmtDate(t.scheduled.end)}`, '',
      'Created by the CivicWatch Gantt \u2014 civicwatch.app'].filter(Boolean).join('\\n');
    return ['BEGIN:VEVENT', `UID:${uid()}@civicwatch.app`, `DTSTAMP:${now}`,
      `DTSTART;VALUE=DATE:${icsDate(t.scheduled.start)}`,
      `DTEND;VALUE=DATE:${icsDate(t.scheduled.end)}`,
      `SUMMARY:${ph.emoji} ${t.name}`, `DESCRIPTION:${desc}`,
      `CATEGORIES:CivicWatch,${t.phase}`, 'STATUS:CONFIRMED', 'END:VEVENT'].filter(Boolean).join('\r\n');
  }).join('\r\n');
  return ['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//CivicWatch//Launch Schedule//EN','CALSCALE:GREGORIAN',
    'X-WR-CALNAME:CivicWatch Launch Schedule', cals, 'END:VCALENDAR'].join('\r\n');
}
function dlICS(content, fname){
  const blob = new Blob([content],{type:'text/calendar'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = fname; a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
function exportAll(){ dlICS(generateICS(TASKS), 'civicwatch-gantt.ics'); }
function exportTaskById(id){ dlICS(generateICS([TASKS.find(x=>x.id===id)]), `civicwatch-task-${id}.ics`); }
function exportPhase(name){ dlICS(generateICS(TASKS.filter(t=>t.phase===name)), `civicwatch-phase-${name.toLowerCase().replace(/[^a-z0-9]+/g,'-')}.ics`); }

// ─── TOAST ───────────────────────────────────────────────────────────────────
function toast(m){
  let t = document.getElementById('toast');
  if(!t){ t = document.createElement('div'); t.id='toast';
    t.style.cssText='position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--surface2);border:1px solid var(--border);padding:10px 18px;border-radius:8px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:999;font-size:12px';
    document.body.appendChild(t);
  }
  t.textContent = m; t.style.opacity = '1';
  clearTimeout(t._h); t._h = setTimeout(()=>{ t.style.opacity='0'; }, 2400);
}

// ─── PANEL ───────────────────────────────────────────────────────────────────
let activeId = null;
function openPanel(id){
  activeId = id;
  const t = TASKS.find(x=>x.id===id);
  const ph = PHASES[t.phase] || {emoji:'', color:'#64748b'};
  const isDone = t.status === 'done';
  const vd = t.varianceDays || 0;
  const varColor = vd>0 ? 'var(--launch)' : (vd<0 ? 'var(--early)' : 'var(--muted)');
  const varLabel = vd===0 ? '' : ` <span style="color:${varColor};font-weight:700">(${vd>0?'+':''}${vd}d ${vd>0?'late':'early'})</span>`;
  const depsHtml = t.dependsOn.length ? `<div class="prow"><dt>Depends on</dt><dd>${t.dependsOn.join(', ')}</dd></div>` : '';
  const blocksHtml = t.blocks.length ? `<div class="prow"><dt>Blocks</dt><dd>${t.blocks.join(', ')}</dd></div>` : '';

  document.getElementById('panel-title').textContent = t.name;
  document.getElementById('panel-body').innerHTML = `
    <dl>
      <div class="prow"><dt>Phase</dt><dd>${ph.emoji} ${t.phase}</dd></div>
      <div class="prow"><dt>Planned</dt><dd>${fmtDate(t.planned.start)} → ${fmtDate(t.planned.end)}</dd></div>
      <div class="prow"><dt>Scheduled</dt><dd>${fmtDate(t.scheduled.start)} → ${fmtDate(t.scheduled.end)}${varLabel}</dd></div>
      ${depsHtml}
      ${blocksHtml}
      ${t.note?`<div class="prow"><dt>Note</dt><dd style="color:var(--muted)">${t.note}</dd></div>`:''}
      ${t.needsAttention?`<div class="prow"><dt>Flag</dt><dd style="color:var(--launch)">${t.attentionReason}</dd></div>`:''}
      <div class="prow"><dt>Status</dt><dd>${isDone?`✅ Done (${fmtDate(t.actualCompletionDate)})`:'⏳ Pending'}</dd></div>
    </dl>
    <button class="panel-btn btn-cal" onclick="exportTaskById(${id})">📅 Add to Calendar</button>
    <button class="panel-btn btn-phase-cal" onclick="exportPhase('${t.phase.replace(/'/g,"\\'")}')">📅 Export All ${t.phase} Tasks</button>
    ${isDone
      ? `<button class="panel-btn btn-plain" onclick="quickToggleDone(${id})">✏️ Edit completion date</button>
         <button class="panel-btn btn-plain" onclick="markPending(${id})">↩ Mark Pending</button>`
      : `<button class="panel-btn btn-plain" onclick="quickToggleDone(${id})">✓ Mark Done…</button>`
    }
  `;
  document.getElementById('panel').classList.add('open');
}
function closePanel(){ document.getElementById('panel').classList.remove('open'); activeId=null; }

// ─── FILTERS ─────────────────────────────────────────────────────────────────
let phaseFilter = new Set(SNAPSHOT.phases.map(p=>p.name));
function togglePhase(btn, name){
  if(phaseFilter.has(name)){ phaseFilter.delete(name); btn.classList.remove('active'); btn.classList.add('inactive'); }
  else{ phaseFilter.add(name); btn.classList.remove('inactive'); btn.classList.add('active'); }
  applyFilters();
}
function applyFilters(){
  const q = (document.getElementById('search').value||'').toLowerCase();
  document.querySelectorAll('.ph-group').forEach(g=>{
    const name = g.dataset.phase;
    if(!phaseFilter.has(name)){ g.classList.add('hidden'); return; }
    g.classList.remove('hidden');
    g.querySelectorAll('[data-id]').forEach(el=>{
      const id = +el.dataset.id;
      const t = TASKS.find(x=>x.id===id);
      const visible = !q || t.name.toLowerCase().includes(q) || (t.note||'').toLowerCase().includes(q);
      el.style.display = visible ? '' : 'none';
    });
  });
}

// ─── STATS ───────────────────────────────────────────────────────────────────
function updateStats(){
  const T = SNAPSHOT.totals, L = SNAPSHOT.launch || {};
  document.getElementById('s-total').textContent = T.total;
  document.getElementById('s-done').textContent  = T.done;
  document.getElementById('s-rem').textContent   = T.remaining;
  document.getElementById('s-pct').textContent   = T.pctDone+'%';
  const attEl = document.getElementById('s-att');
  attEl.textContent = SNAPSHOT.needsAttentionCount;
  attEl.style.color = SNAPSHOT.needsAttentionCount ? 'var(--launch)' : 'var(--early)';

  const launchEl = document.getElementById('s-launch');
  if(L.projected && L.varianceDays){
    const color = L.varianceDays>0 ? 'var(--launch)' : 'var(--early)';
    launchEl.innerHTML = `${fmtDate(L.projected)} <span style="color:${color}">(${L.varianceDays>0?'+':''}${L.varianceDays}d vs plan)</span>`;
  } else {
    launchEl.textContent = fmtDate(L.planned);
  }
  const daysLeft = L.projected ? Math.ceil((parseDate(L.projected)-TODAY)/864e5) : null;
  document.getElementById('s-days').textContent = daysLeft===null ? '—' : (daysLeft > 0 ? daysLeft : 'LAUNCHED!');
}

// ─── RENDER WINDOW ───────────────────────────────────────────────────────────
let RENDER_START, RENDER_END, RENDER_W;
function dateToX(s){ return Math.round((parseDate(s) - RENDER_START)/864e5) * DAY_W; }

function buildDateHeader(){
  const hdr = document.getElementById('date-header');
  hdr.innerHTML = ''; hdr.style.width = RENDER_W+'px';
  const monthRow = document.createElement('div');
  monthRow.style.cssText = 'display:flex;height:18px;border-bottom:1px solid var(--border)';
  let cur = new Date(RENDER_START);
  while(cur <= RENDER_END){
    const m = cur.getMonth();
    const label = cur.toLocaleDateString('en-US',{month:'short',year:'2-digit'});
    let days = 0; const tmp = new Date(cur);
    while(tmp <= RENDER_END && tmp.getMonth()===m){ days++; tmp.setDate(tmp.getDate()+1); }
    const cell = document.createElement('div');
    cell.className = 'month-cell'; cell.style.width = (days*DAY_W)+'px'; cell.textContent = label;
    monthRow.appendChild(cell); cur.setMonth(m+1,1);
  }
  hdr.appendChild(monthRow);
  const weekRow = document.createElement('div');
  weekRow.className = 'week-row'; weekRow.style.height = '18px';
  cur = new Date(RENDER_START);
  while(cur <= RENDER_END){
    const cell = document.createElement('div');
    cell.className = 'week-cell'; cell.style.width = (7*DAY_W)+'px';
    cell.textContent = `${cur.toLocaleDateString('en-US',{month:'short'})} ${cur.getDate()}`;
    weekRow.appendChild(cell); cur.setDate(cur.getDate()+7);
  }
  hdr.appendChild(weekRow);
}

function buildRows(){
  const labelCol  = document.getElementById('label-col');
  const ganttRows = document.getElementById('gantt-rows');
  const inner     = document.getElementById('gantt-inner');
  labelCol.innerHTML = ''; ganttRows.innerHTML = ''; inner.style.width = RENDER_W+'px';

  const togglesDiv = document.getElementById('phase-toggles');
  togglesDiv.innerHTML = '';
  const togglesRow = document.createElement('div');
  togglesRow.style.cssText = 'display:flex;gap:4px;flex-wrap:wrap';
  SNAPSHOT.phases.forEach(ph=>{
    const btn = document.createElement('button');
    btn.className = 'ph-btn ' + (phaseFilter.has(ph.name) ? 'active' : 'inactive');
    btn.style.cssText = `background:${ph.color}22;color:${ph.color};border-color:${ph.color}`;
    btn.textContent = `${ph.emoji} ${ph.name}`;
    btn.onclick = ()=>togglePhase(btn, ph.name);
    togglesRow.appendChild(btn);
  });
  togglesDiv.appendChild(togglesRow);

  const gridContainer = document.createElement('div');
  gridContainer.style.cssText = `position:absolute;top:0;left:0;width:${RENDER_W}px;bottom:0;pointer-events:none;z-index:1`;
  let gd = new Date(RENDER_START);
  while(gd <= RENDER_END){
    const line = document.createElement('div');
    line.className = 'col-grid'; line.style.left = (Math.round((gd-RENDER_START)/864e5)*DAY_W)+'px';
    gridContainer.appendChild(line); gd.setDate(gd.getDate()+7);
  }
  ganttRows.appendChild(gridContainer);

  SNAPSHOT.phases.forEach(ph=>{
    const phaseTasks = TASKS.filter(t=>t.phase===ph.name);
    if(!phaseTasks.length) return;

    const group = document.createElement('div');
    group.className = 'ph-group' + (phaseFilter.has(ph.name) ? '' : ' hidden');
    group.dataset.phase = ph.name;
    const labelGroup = document.createElement('div');
    labelGroup.className = 'ph-group' + (phaseFilter.has(ph.name) ? '' : ' hidden');
    labelGroup.dataset.phase = ph.name;

    const done = phaseTasks.filter(t=>t.status==='done').length;
    const lHead = document.createElement('div');
    lHead.className = 'ph-header-label';
    lHead.style.cssText = `color:${ph.color};border-left:3px solid ${ph.color};height:30px`;
    lHead.innerHTML = `<span>${ph.emoji}</span><span style="flex:1">${ph.name}</span><span style="font-size:10px;color:var(--muted);font-weight:400">${done}/${phaseTasks.length}</span>`;
    labelGroup.appendChild(lHead);

    const gHead = document.createElement('div');
    gHead.className = 'ph-header-gantt'; gHead.style.height = '30px';
    group.appendChild(gHead);

    phaseTasks.forEach(t=>{
      const isDone = t.status === 'done';
      const vd = t.varianceDays || 0;

      const lr = document.createElement('div');
      lr.className = 'task-label' + (isDone?' done':'');
      lr.dataset.id = t.id;
      lr.onclick = ()=>openPanel(t.id);
      const num = document.createElement('span');
      num.className = 'task-num'; num.textContent = t.id + '.';
      const ck = document.createElement('div');
      ck.className = 'task-check'+(isDone?' checked':'');
      ck.onclick = e=>{ e.stopPropagation(); quickToggleDone(t.id); };
      const nm = document.createElement('span');
      nm.className = 'task-name'; nm.textContent = t.name;
      lr.appendChild(num); lr.appendChild(ck); lr.appendChild(nm);
      if(vd!==0){
        const badge = document.createElement('span');
        badge.className = 'task-badge'; badge.style.color = vd>0 ? '#ef4444' : '#22c55e';
        badge.textContent = (vd>0?'+':'')+vd+'d';
        lr.appendChild(badge);
      }
      if(t.needsAttention){
        const flag = document.createElement('span');
        flag.className = 'task-badge'; flag.style.color = '#f0883e'; flag.title = t.attentionReason;
        flag.textContent = '⚠';
        lr.appendChild(flag);
      }
      labelGroup.appendChild(lr);

      const gr = document.createElement('div');
      gr.className = 'task-row'+(isDone?' done':'');
      gr.dataset.id = t.id;
      gr.onclick = ()=>openPanel(t.id);

      // Ghost bar: original plan.
      if(t.planned.start && t.planned.end){
        const pSpan = Math.round((parseDate(t.planned.end)-parseDate(t.planned.start))/864e5)+1;
        const pBar = document.createElement('div');
        pBar.style.cssText = `position:absolute;top:11px;height:8px;border-radius:3px;left:${dateToX(t.planned.start)+1}px;width:${Math.max(pSpan*DAY_W-2,4)}px;background:#39405066`;
        gr.appendChild(pBar);
      }
      // Live bar: current schedule, colored by status.
      if(t.scheduled.start && t.scheduled.end){
        const sSpan = Math.round((parseDate(t.scheduled.end)-parseDate(t.scheduled.start))/864e5)+1;
        const bar = document.createElement('div');
        bar.className = 'task-bar'+(isDone?' done':'')+(vd!==0?' shifted':'');
        const barColor = isDone ? '#3fb950' : (t.needsAttention ? '#f0883e' : ph.color);
        const barW = Math.max(sSpan*DAY_W - 2, 4);
        bar.style.cssText = `left:${dateToX(t.scheduled.start)+1}px;width:${barW}px;background:${barColor}cc;border:1px solid ${barColor}`;
        if(barW > 80) bar.textContent = t.name;
        else if(barW > 30) bar.textContent = t.name.slice(0,8)+'…';
        bar.title = t.name + (vd!==0 ? ` (${vd>0?'+':''}${vd}d vs plan)` : '');
        bar.onclick = e=>{ e.stopPropagation(); openPanel(t.id); };
        gr.appendChild(bar);
      }
      group.appendChild(gr);
    });

    labelCol.appendChild(labelGroup);
    ganttRows.appendChild(group);
  });

  function addVLine(date_s, cls, label, labelColor, lineColor){
    if(!date_s) return;
    const x = dateToX(date_s);
    const line = document.createElement('div');
    line.className = `vline ${cls}`; line.style.left = x+'px';
    if(lineColor) line.style.background = lineColor;
    const lbl = document.createElement('div');
    lbl.className = 'vline-label';
    lbl.style.cssText = `left:${x+4}px;color:${labelColor};background:var(--bg)`;
    lbl.textContent = label;
    ganttRows.appendChild(line); ganttRows.appendChild(lbl);
  }
  addVLine(TODAY_S, 'vline-today', `▲ Today ${fmtDate(TODAY_S).replace(/, \d{4}$/,'')}`, '#facc15');
  const L = SNAPSHOT.launch || {};
  addVLine(L.planned, 'vline-launch', '🚀 Launch (planned)', '#ef4444');
  if(L.projected && L.projected !== L.planned){
    const late = parseDate(L.projected) > parseDate(L.planned);
    const c = late ? '#f97316' : '#22c55e';
    addVLine(L.projected, 'vline-projected', `🚀 Projected: ${fmtDate(L.projected)}`, c, c);
  }
}

function renderAll(){
  recompute();
  let minD = null, maxD = null;
  TASKS.forEach(t=>{
    [t.planned, t.scheduled].forEach(k=>{
      if(k && k.start){ const d=parseDate(k.start); if(!minD||d<minD) minD=d; }
      if(k && k.end){ const d=parseDate(k.end); if(!maxD||d>maxD) maxD=d; }
    });
  });
  if(!minD) minD = TODAY; if(!maxD) maxD = TODAY;
  if(TODAY < minD) minD = TODAY; if(TODAY > maxD) maxD = TODAY;
  RENDER_START = minD; RENDER_END = maxD;
  const totalDays = Math.round((RENDER_END-RENDER_START)/864e5) + 1;
  RENDER_W = totalDays * DAY_W;

  buildDateHeader();
  buildRows();
  updateStats();
  applyFilters();
  if(activeId!==null) openPanel(activeId);
}

function boot(){
  fetch('gantt-state.json',{cache:'no-store'})
    .then(r=>{ if(!r.ok) throw new Error(r.status); return r.json(); })
    .then(j=>{ adoptExternal(j); loadOverlay(); renderAll(); })
    .catch(()=>{ loadOverlay(); renderAll(); }); // fall back to the embedded snapshot
}
function adoptExternal(j){
  // Re-point SNAPSHOT/TASKS at a freshly-fetched gantt-state.json, mapping its
  // schema (phases: string[]) onto this file's phase metadata (color/emoji).
  const nameToMeta = {}; SNAPSHOT.phases.forEach(p=>{ nameToMeta[p.name] = p; });
  const phases = (j.phases||[]).map(name => nameToMeta[name] || {name, emoji:'\u{1F539}', color:'#64748b'});
  const tasksByName = {}; (j.tasks||[]).forEach(t=>{ tasksByName[t.name] = t; });
  const tasks = (j.tasks||[]).map(t => ({
    id: t.id, name: t.name, phase: t.phase, planned: t.planned, scheduled: t.scheduled,
    status: t.status, actualCompletionDate: t.actualCompletionDate, varianceDays: t.varianceDays||0,
    needsAttention: t.needsAttention||false, attentionReason: t.attentionReason||null,
    dependsOn: t.dependsOn||[], note: t.note,
    blocks: (j.tasks||[]).filter(o=>(o.dependsOn||[]).includes(t.name)).map(o=>o.name),
  }));
  SNAPSHOT.phases = phases; SNAPSHOT.totals = j.totals; SNAPSHOT.launch = j.launch;
  SNAPSHOT.needsAttentionCount = j.needsAttentionCount;
  TASKS.length = 0; TASKS.push(...tasks);
  phaseFilter = new Set(phases.map(p=>p.name));
}
boot();
</script>
</body>
</html>
