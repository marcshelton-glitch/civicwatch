<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CivicWatch — Launch Schedule</title>
<style>

:root{
  --bg:#0f1117;--surface:#1a1d27;--surface2:#22263a;--border:#2e3250;
  --text:#e2e8f0;--muted:#8892a4;--accent:#3b82f6;--today:#facc15;--launch:#ef4444;--early:#22c55e;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;overflow-x:hidden}

/* TOOLBAR */
#toolbar{position:sticky;top:0;z-index:100;background:var(--surface);border-bottom:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
#toolbar h1{font-size:15px;font-weight:700;color:var(--text);white-space:nowrap;margin-right:4px}
#toolbar h1 span{color:var(--accent)}
#search{background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:5px 10px;color:var(--text);font-size:12px;width:180px}
#search:focus{outline:none;border-color:var(--accent)}
.ph-btn{padding:4px 10px;border-radius:20px;border:1px solid;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s}
.ph-btn.active{opacity:1}
.ph-btn.inactive{opacity:.35}
#toolbar-right{margin-left:auto;display:flex;gap:8px;align-items:center}
#export-all{background:var(--accent);color:#fff;border:none;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap}
#export-all:hover{background:#2563eb}
#reset-btn{background:none;color:var(--muted);border:1px solid var(--border);border-radius:6px;padding:6px 10px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap}
#reset-btn:hover{color:var(--text);border-color:var(--launch)}
#export-progress{background:none;color:var(--accent);border:1px solid var(--accent);border-radius:6px;padding:6px 10px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap}
#export-progress:hover{background:var(--accent);color:#fff}
#autosave-btn{background:none;color:var(--muted);border:1px solid var(--border);border-radius:6px;padding:6px 10px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap}
#autosave-btn:hover{color:var(--text);border-color:var(--accent)}
#autosave-btn.active{color:var(--early);border-color:var(--early)}
#legend{display:flex;gap:12px;align-items:center;font-size:11px;color:var(--muted)}
#legend span{display:flex;align-items:center;gap:4px}
#legend .dot{width:8px;height:8px;border-radius:50%;display:inline-block}

/* STATS */
#stats{background:var(--surface2);border-bottom:1px solid var(--border);padding:8px 16px;display:flex;gap:24px;font-size:12px;color:var(--muted);flex-wrap:wrap}
#stats b{color:var(--text)}

/* MAIN LAYOUT */
#app{display:flex;position:relative}

/* LABEL COLUMN */
#label-col{width:230px;min-width:230px;flex-shrink:0;border-right:1px solid var(--border)}
.ph-header-label{padding:8px 10px;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:6px}
.task-label{height:30px;padding:0 10px 0 20px;display:flex;align-items:center;gap:6px;border-bottom:1px solid rgba(255,255,255,.03);cursor:pointer;transition:background .1s}
.task-label:hover{background:var(--surface2)}
.task-label.done .task-name{text-decoration:line-through;opacity:.4}
.task-check{width:14px;height:14px;border-radius:3px;border:1px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:center;cursor:pointer}
.task-check.checked{background:var(--accent);border-color:var(--accent)}
.task-check.checked::after{content:'✓';color:#fff;font-size:9px}
.task-name{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
.task-num{font-size:11px;color:var(--muted);flex-shrink:0;min-width:16px;text-align:right}
.task-badge{font-size:9px;font-weight:700;flex-shrink:0}

/* GANTT WRAP */
#gantt-wrap{flex:1;overflow-x:auto;position:relative}
#gantt-inner{position:relative;min-width:max-content}

/* DATE HEADER */
#date-header{height:36px;position:sticky;top:0;z-index:50;background:var(--surface);border-bottom:1px solid var(--border);display:flex;flex-direction:column}
.month-cell{border-right:1px solid var(--border);display:flex;align-items:center;padding:0 8px;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}
.week-row{height:18px;display:flex;border-bottom:1px solid var(--border)}
.week-cell{border-right:1px solid rgba(255,255,255,.06);display:flex;align-items:center;justify-content:flex-start;padding-left:3px;font-size:9px;color:var(--muted);flex-shrink:0}

/* GANTT ROWS */
.ph-header-gantt{height:30px;border-bottom:1px solid var(--border);position:relative}
.task-row{height:30px;border-bottom:1px solid rgba(255,255,255,.03);position:relative}
.task-bar{position:absolute;top:7px;height:16px;border-radius:4px;cursor:pointer;display:flex;align-items:center;padding:0 6px;font-size:10px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;transition:filter .15s;min-width:6px}
.task-bar:hover{filter:brightness(1.2)}
.task-bar.done{opacity:.4}
.task-bar.shifted{box-shadow:0 0 0 1px #f59e0b}

/* VERTICAL MARKERS */
.vline{position:absolute;top:0;bottom:0;width:2px;pointer-events:none;z-index:40}
.vline-today{background:var(--today)}
.vline-launch{background:var(--launch)}
.vline-label{position:absolute;top:2px;font-size:9px;font-weight:700;white-space:nowrap;padding:1px 4px;border-radius:3px}

/* SIDE PANEL */
#panel{width:290px;min-width:290px;border-left:1px solid var(--border);background:var(--surface);display:none;flex-direction:column;position:sticky;top:54px;max-height:calc(100vh - 54px);overflow-y:auto}
#panel.open{display:flex}
#panel-header{padding:14px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start}
#panel-title{font-size:14px;font-weight:700;line-height:1.4}
#panel-close{background:none;border:none;color:var(--muted);cursor:pointer;font-size:18px;padding:0 4px;line-height:1}
#panel-close:hover{color:var(--text)}
#panel-body{padding:14px 16px;display:flex;flex-direction:column;gap:12px}
.prow{display:flex;gap:8px;font-size:12px}
.prow dt{color:var(--muted);min-width:66px;flex-shrink:0}
.prow dd{color:var(--text)}
.panel-btn{display:block;width:100%;padding:8px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;border:none;text-align:center}
.btn-cal{background:var(--accent);color:#fff}
.btn-cal:hover{background:#2563eb}
.btn-phase-cal{background:var(--surface2);color:var(--text);border:1px solid var(--border);margin-top:4px}
.btn-phase-cal:hover{border-color:var(--accent);color:var(--accent)}
.btn-link{background:var(--surface2);color:var(--accent);border:1px solid var(--accent)}
.btn-link:hover{background:var(--accent);color:#fff}
.btn-plain{background:var(--surface2);border:1px solid var(--border);color:var(--text);margin-top:4px}
.btn-plain:hover{border-color:var(--accent);color:var(--accent)}

/* COL GRID LINES */
.col-grid{position:absolute;top:0;bottom:0;width:1px;background:rgba(255,255,255,.04);pointer-events:none}

/* HIDDEN */
.ph-group.hidden .task-row,.ph-group.hidden .task-label,.ph-group.hidden .ph-header-label,.ph-group.hidden .ph-header-gantt{display:none}

</style>
</head>
<body>

<div id="toolbar">
  <h1>🏛️ <span>CivicWatch</span> Launch Schedule</h1>
  <input id="search" type="text" placeholder="Search tasks…" oninput="applyFilters()">
  <div id="phase-toggles"></div>
  <div id="legend">
    <span><span class="dot" style="background:var(--today)"></span>Today</span>
    <span><span class="dot" style="background:var(--launch)"></span>Launch (planned)</span>
  </div>
  <div id="toolbar-right">
    <button id="reset-btn" onclick="resetAll()">↺ Reset progress</button>
    <button id="export-progress" onclick="exportProgressSnapshot()">📤 Export for Claude</button>
    <button id="export-all" onclick="exportAll()">📅 Export All to Calendar</button>
  </div>
</div>

<div id="stats">
  <span>Tasks: <b id="s-total">0</b></span>
  <span>Done: <b id="s-done">0</b></span>
  <span>Remaining: <b id="s-rem">0</b></span>
  <span>Progress: <b id="s-pct">0%</b></span>
  <span>Needs attention: <b id="s-att">0</b></span>
  <span>Launch: <b id="s-launch">—</b></span>
  <span>Days to Launch: <b id="s-days">—</b></span>
</div>

<div id="app">
  <div id="label-col"></div>
  <div id="gantt-wrap">
    <div id="gantt-inner">
      <div id="date-header"></div>
      <div id="gantt-rows"></div>
    </div>
  </div>
  <div id="panel">
    <div id="panel-header">
      <div id="panel-title">Task Detail</div>
      <button id="panel-close" onclick="closePanel()">×</button>
    </div>
    <div id="panel-body"></div>
  </div>
</div>

<script id="embedded-gantt-state" type="application/json">{"project":"civicwatch","standardVersion":"1.0.0","exportedAt":"2026-09-01T03:07:22.800053+00:00","today":"2026-08-31","provenance":"Built 2026-08-06 from Calendar Tasks/civicwatch-phase1.ics (14 Phase 1 tasks, Jun 30-Jul 14) and docs/prelaunch-audit-2026-08-03.md. Phase 1 status was set ONLY where the repo contains file evidence; those actualCompletionDates are inferred from planned end dates because none were recorded at the time. Anything without evidence is left pending rather than assumed done. Corrected 2026-08-11: originally built against a stale sandbox clock reading 2026-08-06, so all forward-looking tasks were dated five days early. Historical Phase 1 dates from the .ics are unchanged.","totals":{"total":36,"done":25,"remaining":11,"pctDone":69},"launch":{"planned":"2026-10-12","projected":"2026-10-12","varianceDays":0},"needsAttentionCount":0,"phases":["Phase 1 Hardening","P0 Launch Blockers","P0 Product Claim","Measurement","Brand & Content","Standard Adoption"],"tasks":[{"id":20,"name":"Set STRIPE_CIVICWATCH_PRO_MONTHLY_PRICE_ID and redeploy","phase":"P0 Launch Blockers","planned":{"start":"2026-07-30","end":"2026-07-30"},"scheduled":{"start":"2026-07-30","end":"2026-07-30"},"status":"done","actualCompletionDate":"2026-07-30","varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":["Verify /api/health returns status ok"],"note":"DONE 2026-07-30. STRIPE_CIVICWATCH_PRO_MONTHLY_PRICE_ID=price_1TLc2jPe8la2Z0hhVxP8hdzP (product prod_UKGZ8zZ87dnryG, 'CivicWatch Pro', $9.99/mo, acct_1TJO7aPe8la2Z0hh) — value confirmed by Marc against the Vercel dashboard 2026-08-31; the entry there reads 'Added Jul 30', Production and Preview. The redeploy half completed on its own: many production deployments have shipped since Jul 30, so the variable has been live for a month. It was simply never ticked off.","durationWorkdays":1},{"id":21,"name":"Run one real-card checkout end to end","phase":"P0 Launch Blockers","planned":{"start":"2026-09-01","end":"2026-09-02"},"scheduled":{"start":"2026-09-01","end":"2026-09-02"},"status":"pending","actualCompletionDate":null,"varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":["Set STRIPE_CIVICWATCH_PRO_MONTHLY_PRICE_ID and redeploy"],"durationWorkdays":1},{"id":1,"name":"Add VAPID env vars to Vercel","phase":"Phase 1 Hardening","planned":{"start":"2026-06-30","end":"2026-07-01"},"scheduled":{"start":"2026-06-30","end":"2026-07-01"},"status":"done","actualCompletionDate":"2026-08-25","varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[]},{"id":2,"name":"Write push_subscriptions Supabase migration","phase":"Phase 1 Hardening","planned":{"start":"2026-07-01","end":"2026-07-02"},"scheduled":{"start":"2026-07-01","end":"2026-07-02"},"status":"done","actualCompletionDate":"2026-07-02","varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"supabase/migrations/20260615000002_create_push_subscriptions.sql"},{"id":3,"name":"Wire service worker registration","phase":"Phase 1 Hardening","planned":{"start":"2026-07-02","end":"2026-07-03"},"scheduled":{"start":"2026-07-02","end":"2026-07-03"},"status":"done","actualCompletionDate":"2026-07-03","varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":[],"note":"public/sw.js"},{"id":4,"name":"Implement /api/push/subscribe with Clerk auth","phase":"Phase 1 Hardening","planned":{"start":"2026-07-03","end":"2026-07-04"},"scheduled":{"start":"2026-07-03","end":"2026-07-04"},"status":"done","actualCompletionDate":"2026-07-04","varianceDays":0,"needsAttention":false,"attentionReason":null,"dependsOn":["Wire service worker registration"],"note":"app/api/push/subscribe/"},{"id":5,"name":"Implement /api/push/send via web-push","phase":"Phase 1 Hardening","planned":{"start":"2026-07-04","end":"2026-07-05"},"scheduled":{"start":"2026-07-04","end":"2026-07-05"},"status":"done","actualCompletionDate":"20